default_platform(:ios)

TEAM_ID = "2ZH4RCM3MU"

APP_IDENTIFIERS = {
  "MindSpend" => "com.anpause.app",
  "ShieldConfigurationExtension" => "com.anpause.app.ShieldConfiguration",
  "ShieldActionExtension" => "com.anpause.app.ShieldAction",
  "DeviceActivityMonitorExtension" => "com.anpause.app.DeviceActivityMonitor"
}

platform :ios do
  before_all do
    setup_ci if ENV["CI"]

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )
  end

  desc "Fetch/sync App Store distribution certificates and profiles"
  lane :sync_signing do
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: APP_IDENTIFIERS.values
    )
  end

  desc "Build MindSpend and upload a new build to TestFlight"
  lane :beta do
    sync_signing

    APP_IDENTIFIERS.each do |target, bundle_id|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "MindSpend.xcodeproj",
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        bundle_identifier: bundle_id,
        profile_name: "match AppStore #{bundle_id}",
        targets: [target]
      )
    end

    increment_build_number(
      xcodeproj: "MindSpend.xcodeproj",
      build_number: (latest_testflight_build_number(app_identifier: "com.anpause.app") + 1)
    )

    build_app(
      project: "MindSpend.xcodeproj",
      scheme: "MindSpend",
      export_method: "app-store",
      export_team_id: TEAM_ID
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
